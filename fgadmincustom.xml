<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>plg_system_fgadmincustom</name>
    <author>Fero</author>
    <authorUrl>https://github.com/FGcodework</authorUrl>
    <creationDate>2026-11</creationDate>
    <copyright>(C) 2026. GNU GPL v2 or later.</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>1.0.1</version>
    <description>PLG_SYSTEM_FGADMINCUSTOM_XML_DESCRIPTION</description>
    <namespace path="src">FG\Plugin\System\AdminCustom</namespace>
    <scriptfile>script.php</scriptfile>
    <updateservers>
        <server type="extension" name="System - FG Admin Customizer Update Site">https://raw.githubusercontent.com/FGcodework/plg_system_fgadmincustom/master/updates.xml</server>
    </updateservers>
    <files>
        <folder plugin="fgadmincustom">services</folder>
        <folder>src</folder>
        <folder>language</folder>
        <filename>script.php</filename>
    </files>
    <languages>
        <language tag="en-GB">language/en-GB/plg_system_fgadmincustom.ini</language>
        <language tag="en-GB">language/en-GB/plg_system_fgadmincustom.sys.ini</language>
        <language tag="sk-SK">language/sk-SK/plg_system_fgadmincustom.ini</language>
        <language tag="sk-SK">language/sk-SK/plg_system_fgadmincustom.sys.ini</language>
    </languages>
    <config>
        <inlinehelp button="show" />
        <fields name="params">
            <fieldset name="basic">
                <field name="support_note" type="note" description="PLG_SYSTEM_FGADMINCUSTOM_FIELD_SUPPORT_DESC" />
            </fieldset>
            <fieldset name="brand" label="PLG_SYSTEM_FGADMINCUSTOM_FIELDSET_BRAND">
                <field name="brand_color" type="color" label="PLG_SYSTEM_FGADMINCUSTOM_BRAND_COLOR_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_BRAND_COLOR_DESC" />
                <field name="ctrl_radius" type="number" label="PLG_SYSTEM_FGADMINCUSTOM_BRAND_CTRL_RADIUS_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_BRAND_CTRL_RADIUS_DESC" default="" min="0" max="40" />
