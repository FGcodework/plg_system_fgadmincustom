                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
            <fieldset name="login_preset" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_FIELDSET_PRESET">
                <field name="login_theme_preset" type="list" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_THEME_PRESET_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_THEME_PRESET_DESC" default="">
                    <option value="">PLG_SYSTEM_FGADMINCUSTOM_LOGIN_THEME_PRESET_NONE</option>
                    <option value="reset">PLG_SYSTEM_FGADMINCUSTOM_LOGIN_THEME_PRESET_RESET</option>
                    <option value="dark">PLG_SYSTEM_FGADMINCUSTOM_LOGIN_THEME_PRESET_DARK</option>
                    <option value="corporate_blue">PLG_SYSTEM_FGADMINCUSTOM_LOGIN_THEME_PRESET_CORPORATE_BLUE</option>
                    <option value="green">PLG_SYSTEM_FGADMINCUSTOM_LOGIN_THEME_PRESET_GREEN</option>
                    <option value="orange">PLG_SYSTEM_FGADMINCUSTOM_LOGIN_THEME_PRESET_ORANGE</option>
                    <option value="minimal">PLG_SYSTEM_FGADMINCUSTOM_LOGIN_THEME_PRESET_MINIMAL</option>
                </field>
            </fieldset>
            <fieldset name="login_background" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_FIELDSET_BACKGROUND">
                <field name="login_bg_type" type="list" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_BG_TYPE_LABEL" default="none">
                    <option value="none">PLG_SYSTEM_FGADMINCUSTOM_LOGIN_BG_TYPE_NONE</option>
                    <option value="color">PLG_SYSTEM_FGADMINCUSTOM_LOGIN_BG_TYPE_COLOR</option>
                    <option value="gradient">PLG_SYSTEM_FGADMINCUSTOM_LOGIN_BG_TYPE_GRADIENT</option>
                    <option value="image">PLG_SYSTEM_FGADMINCUSTOM_LOGIN_BG_TYPE_IMAGE</option>
                </field>
                <field name="login_bg_color" type="color" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_BG_COLOR_LABEL" default="#1c3d5c" showon="login_bg_type:color" />
                <field name="login_grad_start" type="color" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_GRAD_START_LABEL" default="#1c3d5c" showon="login_bg_type:gradient" />
                <field name="login_grad_end" type="color" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_GRAD_END_LABEL" default="#0e1e2e" showon="login_bg_type:gradient" />
                <field name="login_grad_angle" type="number" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_GRAD_ANGLE_LABEL" default="135" min="0" max="360" showon="login_bg_type:gradient" />
                <field name="login_bg_image" type="media" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_BG_IMAGE_LABEL" showon="login_bg_type:image" />
                <field name="login_bg_overlay" type="color" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_BG_OVERLAY_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_BG_OVERLAY_DESC" default="#000000" showon="login_bg_type:image" />
