                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
            <fieldset name="login_logo" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_FIELDSET_LOGO">
                <field name="login_enabled" type="radio" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_ENABLED_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_ENABLED_DESC" layout="joomla.form.field.radio.switcher" default="1">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="login_logo" type="media" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_LOGO_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_LOGO_DESC" />
                <field name="login_logo_dark" type="media" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_LOGO_DARK_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_LOGO_DARK_DESC" />
                <field name="login_logo_width" type="number" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_LOGO_WIDTH_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_LOGO_WIDTH_DESC" default="220" min="40" max="800" />
                <field name="login_logo_height" type="number" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_LOGO_HEIGHT_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_LOGO_HEIGHT_DESC" min="20" max="600" />
                <field name="login_logo_fit" type="list" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_LOGO_FIT_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_LOGO_FIT_DESC" default="contain">
