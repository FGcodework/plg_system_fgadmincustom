                    <option value="1">JYES</option>
                </field>
                <field name="login_brand_color" type="color" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_BRAND_COLOR_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_BRAND_COLOR_DESC" />
                <field name="login_card_bg" type="color" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_CARD_BG_LABEL" />
                <field name="login_card_text" type="color" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_CARD_TEXT_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_AUTO_CONTRAST_DESC" />
                <field name="login_card_radius" type="number" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_CARD_RADIUS_LABEL" default="" min="0" max="60" />
                <field name="login_card_shadow" type="list" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_CARD_SHADOW_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_CARD_SHADOW_DESC" default="">
                    <option value="">PLG_SYSTEM_FGADMINCUSTOM_SHADOW_INHERIT</option>
                    <option value="none">PLG_SYSTEM_FGADMINCUSTOM_SHADOW_NONE</option>
                    <option value="subtle">PLG_SYSTEM_FGADMINCUSTOM_SHADOW_SUBTLE</option>
                    <option value="medium">PLG_SYSTEM_FGADMINCUSTOM_SHADOW_MEDIUM</option>
                    <option value="strong">PLG_SYSTEM_FGADMINCUSTOM_SHADOW_STRONG</option>
                </field>
                <field name="login_ctrl_radius" type="number" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_CTRL_RADIUS_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_CTRL_RADIUS_DESC" default="" min="0" max="40" />
                <field name="login_btn_shadow" type="list" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_BTN_SHADOW_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_BTN_SHADOW_DESC" default="">
                    <option value="">PLG_SYSTEM_FGADMINCUSTOM_SHADOW_INHERIT</option>
                    <option value="none">PLG_SYSTEM_FGADMINCUSTOM_SHADOW_NONE</option>
                    <option value="subtle">PLG_SYSTEM_FGADMINCUSTOM_SHADOW_SUBTLE</option>
                    <option value="medium">PLG_SYSTEM_FGADMINCUSTOM_SHADOW_MEDIUM</option>
                    <option value="strong">PLG_SYSTEM_FGADMINCUSTOM_SHADOW_STRONG</option>
                </field>
                <field name="login_btn_bg" type="color" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_BTN_BG_LABEL" />
                <field name="login_btn_hover" type="color" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_BTN_HOVER_LABEL" />
                <field name="login_btn_text" type="color" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_BTN_TEXT_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_AUTO_CONTRAST_DESC" />
                <field name="login_link_color" type="color" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_LINK_COLOR_LABEL" />
            </fieldset>
            <fieldset name="login_headerbar" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_FIELDSET_HEADER">
                <field name="login_header_bg" type="color" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_HEADER_BG_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_HEADER_BG_DESC" />
                <field name="login_header_text" type="color" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_HEADER_TEXT_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_AUTO_CONTRAST_DESC" />
                <field name="login_hide_lang_switcher" type="radio" layout="joomla.form.field.radio.switcher" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_HIDE_LANG_SWITCHER_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_HIDE_LANG_SWITCHER_DESC" default="0">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="login_header_match_btn" type="radio" layout="joomla.form.field.radio.switcher" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_HEADER_MATCH_BTN_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_HEADER_MATCH_BTN_DESC" default="0">
