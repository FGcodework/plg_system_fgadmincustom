                <field name="login_use_brand" type="radio" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_USE_BRAND_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_USE_BRAND_DESC" layout="joomla.form.field.radio.switcher" default="1">
