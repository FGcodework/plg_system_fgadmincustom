                <field name="login_hide_template_logo" type="radio" layout="joomla.form.field.radio.switcher" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_HIDE_TEMPLATE_LOGO_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_HIDE_TEMPLATE_LOGO_DESC" default="1">
