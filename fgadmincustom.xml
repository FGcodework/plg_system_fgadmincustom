                <field name="import_json" type="textarea" label="PLG_SYSTEM_FGADMINCUSTOM_IMPORT_JSON_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_IMPORT_JSON_DESC" rows="10" filter="raw" />
