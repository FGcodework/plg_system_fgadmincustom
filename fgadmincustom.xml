                    <option value="1">JYES</option>
                </field>
                <field name="admin_sidebar_color" type="color" label="PLG_SYSTEM_FGADMINCUSTOM_ADMIN_SIDEBAR_COLOR_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_ADMIN_SIDEBAR_COLOR_DESC" />
