                <field name="btn_shadow" type="list" label="PLG_SYSTEM_FGADMINCUSTOM_BRAND_BTN_SHADOW_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_BRAND_BTN_SHADOW_DESC" default="none">
                    <option value="none">PLG_SYSTEM_FGADMINCUSTOM_SHADOW_NONE</option>
                    <option value="subtle">PLG_SYSTEM_FGADMINCUSTOM_SHADOW_SUBTLE</option>
                    <option value="medium">PLG_SYSTEM_FGADMINCUSTOM_SHADOW_MEDIUM</option>
                    <option value="strong">PLG_SYSTEM_FGADMINCUSTOM_SHADOW_STRONG</option>
                </field>
                <field name="card_shadow" type="list" label="PLG_SYSTEM_FGADMINCUSTOM_BRAND_CARD_SHADOW_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_BRAND_CARD_SHADOW_DESC" default="none">
                    <option value="none">PLG_SYSTEM_FGADMINCUSTOM_SHADOW_NONE</option>
                    <option value="subtle">PLG_SYSTEM_FGADMINCUSTOM_SHADOW_SUBTLE</option>
                    <option value="medium">PLG_SYSTEM_FGADMINCUSTOM_SHADOW_MEDIUM</option>
                    <option value="strong">PLG_SYSTEM_FGADMINCUSTOM_SHADOW_STRONG</option>
                </field>
            </fieldset>
            <fieldset name="admin" label="PLG_SYSTEM_FGADMINCUSTOM_FIELDSET_ADMIN">
                <field name="admin_enabled" type="radio" label="PLG_SYSTEM_FGADMINCUSTOM_ADMIN_ENABLED_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_ADMIN_ENABLED_DESC" layout="joomla.form.field.radio.switcher" default="1">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="admin_header_color" type="color" label="PLG_SYSTEM_FGADMINCUSTOM_ADMIN_HEADER_COLOR_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_ADMIN_HEADER_COLOR_DESC" />
