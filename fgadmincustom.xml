                <field name="login_custom_js" type="textarea" label="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_CUSTOM_JS_LABEL" description="PLG_SYSTEM_FGADMINCUSTOM_LOGIN_CUSTOM_JS_DESC" rows="12" filter="raw" />
